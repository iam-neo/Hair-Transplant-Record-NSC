function doGet() { return respond_({ok:false,error:'Use authenticated POST requests.',code:'METHOD_NOT_ALLOWED'}); }
function doPost(e) { try { var request=JSON.parse(e.postData.contents||'{}'); return respond_(route_(request)); } catch(err) { console.error(err.stack||err); return respond_({ok:false,error:err.message||'The server could not process this request.',code:err.code||'SERVER_ERROR'}); } }
function respond_(body) { return ContentService.createTextOutput(JSON.stringify(body)).setMimeType(ContentService.MimeType.JSON); }
function route_(request) { var action=request.action, payload=request.payload||{}; if(action==='auth.login') return login_(payload); var user=requireSession_(request.token); if(action==='auth.me') return ok_(publicUser_(user)); if(action==='auth.logout') return logout_(request.token); if(action==='dashboard.summary') return dashboard_(user); if(action==='patients.list') return listPatients_(user,payload); if(action==='patients.duplicates') return duplicatePatients_(user,payload); if(action==='patients.create') return createPatient_(user,payload); if(action==='patients.get') return getPatient_(user,payload); if(action==='patients.archive') return archivePatient_(user,payload); if(action==='activity.list') return activityList_(user,payload); if(action.indexOf('users.')===0) return userAction_(user,action,payload); if(action.indexOf('followups.')===0) return followUpAction_(user,action,payload); if(action.indexOf('photos.')===0) return photoAction_(user,action,payload); if(action.indexOf('payments.')===0) return paymentAction_(user,action,payload); if(action.indexOf('documents.')===0) return documentAction_(user,action,payload); if(action.indexOf('consultations.')===0||action.indexOf('assessments.')===0||action.indexOf('procedures.')===0) return clinicalAction_(user,action,payload); throw clientError_('Unknown API operation.','NOT_FOUND'); }
function ok_(data) { return {ok:true,data:data}; }
function clientError_(message,code) { var err=new Error(message); err.code=code||'BAD_REQUEST'; return err; }
