function userAction_(u,a,p){requirePermission_(u,'users.view');if(a==='users.list')return ok_({items:rows_('Users').map(publicUser_).map(function(x){return {id:x.id,name:x.name,email:x.email,role:x.role,permissions:x.permissions};})});if(a==='users.create'){requirePermission_(u,'users.create');if(!p.fullName||!p.email||!p.username||!p.password||!p.role)throw clientError_('Name, email, username, temporary password, and role are required.');if(find_('Users','Email',p.email)||find_('Users','Username',p.username))throw clientError_('An account with that email or username already exists.');var salt=Utilities.getUuid(),id=nextId_('USR'),now=new Date();append_('Users',{UserID:id,FullName:p.fullName,Email:p.email,Username:p.username,PasswordHash:hashPassword_(p.password,salt),PasswordSalt:salt,Role:p.role,Permissions:(p.permissions||[]).join(','),Status:'Active',CreatedAt:now,UpdatedAt:now});audit_(u,'','CREATE','User',id,'User account created');return ok_({id:id});}if(a==='users.deactivate'){requirePermission_(u,'users.deactivate');if(p.userId===u.UserID)throw clientError_('You cannot deactivate your own account.');var s=sheet_('Users'),v=s.getDataRange().getValues(),h=v[0],row=v.findIndex(function(r,i){return i>0&&r[h.indexOf('UserID')]===p.userId;});if(row<1)throw clientError_('User not found.','NOT_FOUND');s.getRange(row+1,h.indexOf('Status')+1).setValue('Disabled');s.getRange(row+1,h.indexOf('UpdatedAt')+1).setValue(new Date());audit_(u,'','DEACTIVATE','User',p.userId,'User account disabled');return ok_({id:p.userId});}throw clientError_('Unsupported user action.','NOT_FOUND');}
