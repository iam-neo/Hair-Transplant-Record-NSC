function dashboard_(u){requirePermission_(u,'patients.view');var patients=rows_('Patients').filter(function(x){return x.Status==='Active';}),follow=rows_('FollowUps').filter(function(x){return x.Status==='Scheduled';}),payments=rows_('Payments'),month=Utilities.formatDate(new Date(),Session.getScriptTimeZone(),'yyyy-MM'),procedures=rows_('Procedures').filter(function(x){return String(x.ProcedureDate).indexOf(month)===0;});return ok_({patients:patients.length,proceduresThisMonth:procedures.length,upcomingFollowUps:follow.length,outstandingBalance:0,followUps:follow.slice(0,8).map(function(x){var p=find_('Patients','PatientID',x.PatientID);return {id:x.FollowUpID,patient:p?p.FullName:x.PatientID,date:x.FollowUpDate,type:x.FollowUpType,status:x.Status};})});}
