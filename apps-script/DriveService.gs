function ensureRootFolder_(){var props=PropertiesService.getScriptProperties(),id=props.getProperty('NSC_ROOT_FOLDER_ID');if(id)return DriveApp.getFolderById(id);var roots=DriveApp.getFoldersByName(NSC_CONFIG.rootFolderName),root=roots.hasNext()?roots.next():DriveApp.createFolder(NSC_CONFIG.rootFolderName),ht=findOrCreateFolder_(root,'Hair Transplant'),patients=findOrCreateFolder_(ht,'Patients');props.setProperty('NSC_ROOT_FOLDER_ID',patients.getId());return patients;}
function findOrCreateFolder_(parent,name){var it=parent.getFoldersByName(name);return it.hasNext()?it.next():parent.createFolder(name);}
function createPatientFolders_(patient){var root=ensureRootFolder_(),folder=findOrCreateFolder_(root,patient.PatientID+' - '+sanitizeFileName_(patient.FullName));['Consultation','Documents','Before Transplant','Procedure','After Transplant','Follow-up','Other'].forEach(function(n){findOrCreateFolder_(folder,n);});return folder;}
function patientFolder_(patientId){var p=find_('Patients','PatientID',patientId);if(!p)throw clientError_('Patient not found.','NOT_FOUND');return createPatientFolders_(p);}
function sanitizeFileName_(name){return String(name||'file').replace(/[^a-zA-Z0-9._ -]/g,'_').replace(/\s+/g,' ').slice(0,120);}
function savePrivateFile_(folder,base64,mimeType,fileName){var bytes=Utilities.base64Decode(base64),blob=Utilities.newBlob(bytes,mimeType,sanitizeFileName_(fileName)),file=folder.createFile(blob);file.setSharing(DriveApp.Access.PRIVATE,DriveApp.Permission.VIEW);return file;}
