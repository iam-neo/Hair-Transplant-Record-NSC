function sendDueReminders_(){var lock=LockService.getScriptLock();lock.waitLock(30000);try{rows_('Reminders').filter(function(r){return r.Status==='Scheduled'&&new Date(r.ScheduledAt)<=new Date();}).forEach(function(r){try{MailApp.sendEmail(r.Recipient,'Follow-up reminder | '+NSC_CONFIG.clinicName,'You have a scheduled hair transplant follow-up.');updateReminderStatus_(r.ReminderID,'Sent','');}catch(e){updateReminderStatus_(r.ReminderID,'Failed',e.message);}});}finally{lock.releaseLock();}}
function updateReminderStatus_(id,status,reason){var s=sheet_('Reminders'),v=s.getDataRange().getValues(),h=v[0],idCol=h.indexOf('ReminderID')+1,row=v.findIndex(function(r,i){return i>0&&r[idCol-1]===id;})+1;if(row>1){s.getRange(row,h.indexOf('Status')+1).setValue(status);s.getRange(row,h.indexOf('SentAt')+1).setValue(status==='Sent'?new Date():'');s.getRange(row,h.indexOf('FailureReason')+1).setValue(reason);s.getRange(row,h.indexOf('UpdatedAt')+1).setValue(new Date());}}
